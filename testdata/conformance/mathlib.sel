material MathLib {
    param baseColor : color
    param light     : Sun
    param phase     : float

    surface(geo) -> color {
        let n = normalize(geo.worldNormal)
        let diffuse = max(dot(n, light.dir), 0)
        let ripple = sin(geo.uv.x * 12.0 + phase) * cos(geo.uv.y * 12.0)
        let bands = step(0.5, fract(geo.uv.y * 6.0))
        let glow = smoothstep(0.1, 0.9, fract(geo.uv.x * 4.0))
        let tangent = cross(n, light.dir)
        let rim = pow(1.0 - diffuse, 3.0)
        let bounce = reflect(light.dir, n)
        let shade = light.ambient + diffuse + ripple * 0.15 + bands * 0.1 + glow * 0.2 + rim * 0.25
        return baseColor * shade + sqrt(abs(tangent.x)) * 0.05 + bounce.y * 0.02
    }
}

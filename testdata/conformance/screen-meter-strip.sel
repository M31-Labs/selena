// screen-meter-strip.sel — a row of level meters drawn by one screen pass.
//
// `levels` holds (peakL, peakR, rmsL, rmsR) in decibels for each strip and
// `holds` holds the peak-hold marks (holdL, holdR). The host fills them every
// frame. Each array is 64 vectors: 128 uniform vectors in all, under the 224
// that GLSL ES 3.00 guarantees. It is not a WebGL 1 example; use a data texture
// (screen-data-texture) for more values. screen.uv runs 0..1 across the target
// rectangle with the origin at the top left, so a bar that grows from the bottom compares against 1 - uv.y.
// screenSize() gives the rectangle's size in pixels, used here to keep a
// one-pixel gap between strips whatever the rectangle's width.
material MeterStrip kind screen {
    render { blend additive  depth off }

    param levels : array<vec4, 64>
    param holds  : array<vec4, 64>
    param strips : float = 16.0

    surface(screen) -> color {
        let x = screen.uv.x * strips
        let i = int(min(floor(x), 63.0))
        let lane = fract(x)
        let gap = strips / screenSize().x
        let body = step(gap, lane) * step(lane, 1.0 - gap)
        let l = levels[i]
        let h = holds[i]
        let peak = lane < 0.5 ? l.x : l.y
        let hold = lane < 0.5 ? h.x : h.y
        let up = 1.0 - screen.uv.y
        let bar = step(up, (peak + 60.0) / 60.0)
        let mark = step(abs(up - (hold + 60.0) / 60.0), gap) * 0.5
        let lit = max(bar, mark) * body
        return rgb(lit * 0.2, lit, lit * 0.4, lit)
    }
}

// Compile with materiallib.BRDF. A planar preview synthesizes hemisphere
// normals to compare varnish, felt sheen and brushed metal.
material BRDFGallery {
    param roughness : float = 0.34
    param energy : float = 1.0
    surface(geo) -> color {
        let section = floor(geo.uv.x * 3.0)
        let p = vec2f(fract(geo.uv.x * 3.0) * 2.0 - 1.0, geo.uv.y * 2.0 - 1.0)
        let n = normalize(vec3f(p, sqrt(max(1.0 - dot(p, p), 0.01))))
        let l = normalize(vec3f(-0.4, 0.7, 1.0))
        let v = vec3f(0.0, 0.0, 1.0)
        let h = normalize(l + v)
        let nv = max(dot(n, v), 0.0)
        let nl = max(dot(n, l), 0.0)
        let nh = max(dot(n, h), 0.0)
        let vh = max(dot(v, h), 0.0)
        let base = vec3f(0.28, 0.075, 0.025) / 3.14159265359
        let wood = mlClearCoat(base, nv, nl, nh, vh, roughness, 0.8) * nl
        let felt = vec3f(0.025, 0.2, 0.075) * nl + mlSheenCharlie(nv, nl, nh, 0.65, vec3f(0.12, 0.24, 0.15)) * nl
        let t = normalize(vec3f(n.z, 0.0, -n.x))
        let b = cross(n, t)
        let vt = vec3f(dot(v, t), dot(v, b), nv)
        let lt = vec3f(dot(l, t), dot(l, b), nl)
        let ht = vec3f(dot(h, t), dot(h, b), nh)
        let zinc = mlAnisotropicGGX(vt, lt, ht, 0.12, 0.42, vec3f(0.56, 0.59, 0.62), energy) * nl
        let color = section < 1.0 ? wood : (section < 2.0 ? felt : zinc)
        return color + vec3f(0.035, 0.035, 0.035)
    }
}

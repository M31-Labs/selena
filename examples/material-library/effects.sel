// Compile with materiallib.Effects (loads Procedural automatically).
material TableEvents {
    param age : float = 0.15
    param intensity : float = 1.0
    param eventPosition : vec2 = vec2(0.5, 0.5)
    param duration : float = 0.65
    surface(geo) -> color {
        let section = floor(geo.uv.x * 3.0)
        let coords = vec2f(fract(geo.uv.x * 3.0), geo.uv.y)
        let ripple = mlRadialRippleAA(coords, eventPosition, age, intensity, duration, 0.55, 0.009)
        let dust = mlDustAA(coords, eventPosition, age, intensity, duration, 0.55, 0.16, 32.0)
        let flash = mlImpactFlashAA(coords, eventPosition, age, intensity, 0.3, 0.065)
        let substrate = vec3f(0.12, 0.065, 0.025)
        let knock = mix(substrate, vec3f(0.39, 0.7, 0.78), ripple)
        let slam = mix(substrate, vec3f(0.8, 0.67, 0.4), dust * 0.85)
        let impact = mix(slam, vec3f(1.0, 0.93, 0.7), flash)
        return section < 1.0 ? knock : (section < 2.0 ? slam : impact)
    }
}

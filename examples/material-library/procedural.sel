// Compile with materiallib.Procedural. Wood, marble and signed fBm bands.
material ProceduralGallery {
    param scale : float = 4.0
    surface(geo) -> color {
        let section = floor(geo.uv.x * 3.0)
        let p = vec2f(fract(geo.uv.x * 3.0), geo.uv.y) * scale
        let woodMask = mlWoodGrainAA(p * vec2f(0.6, 1.0), 28.0, 8.0)
        let wood = mix(vec3f(0.11, 0.025, 0.008), vec3f(0.52, 0.19, 0.055), woodMask)
        let vein = mlMarbleVeinAA(p * 0.8, 9.0, 12.0)
        let marble = mix(vec3f(0.87, 0.85, 0.8), vec3f(0.16, 0.22, 0.23), vein)
        let cloud = 0.5 + mlFBm4AA(p * 2.0) * 0.6
        return section < 1.0 ? wood : (section < 2.0 ? marble : vec3f(cloud, cloud, cloud))
    }
}

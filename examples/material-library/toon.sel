// Toon: cel shading with three light bands, a hard highlight, a rim on the lit
// side and a dark silhouette outline. It reads the key light (sunDir,
// sunColor) and ambient, so it needs only the game module.
material Toon {
    context {
        cameraPos : vec3
        sunDir    : vec3
        sunColor  : vec3
        ambient   : vec3
    }
    param baseColor    : color = rgb(0.85, 0.35, 0.25)
    param shadowColor  : color = rgb(0.25, 0.12, 0.25)
    param outlineColor : color = rgb(0.05, 0.03, 0.06)
    param bands        : float = 3.0
    param outlineWidth : float = 1.5

    surface(geo) -> color {
        let n = normalize(geo.worldNormal)
        let v = normalize(cameraPos - geo.worldPos)
        let l = normalize(sunDir)
        let light = mlToonBands(dot(n, l), bands, 0.08)
        let body = mix(shadowColor, baseColor, light) * (sunColor + ambient)
        let highlight = mlToonSpecular(n, v, l, 0.4, 0.01) * sunColor
        let rim = mlToonRim(n, v, l, 0.35, 0.04) * 0.6
        let shaded = body + highlight + baseColor * rim
        return mix(shaded, outlineColor, mlToonOutline(n, v, outlineWidth))
    }
}

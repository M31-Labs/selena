// screen-overlay.sel — a screen pass with a pipeline declaration, an array
// param, a data texture and screenSize().
material ScreenOverlay kind screen {
    render { blend premultiplied  depth test }

    param bands : array<vec4, 4>
    param trace : texture2d format r16float
    param tint  : color = rgb(0.9, 0.6, 0.2)

    surface(screen) -> color {
        let sz = size(trace)
        let col = int(min(screen.uv.x * sz.x, sz.x - 1.0))
        let v = load(trace, col, 0i).r
        let px = 1.0 / screenSize().y
        let a = clamp(v + bands[1i].x + px, 0.0, 1.0)
        return rgb(tint.r * a, tint.g * a, tint.b * a, a)
    }
}

material Base {
    param baseColor : color
    param light     : Sun

    surface(geo) -> color {
        let n = normalize(geo.worldNormal)
        return baseColor * (light.ambient + max(dot(n, light.dir), 0))
    }
}

material Tinted extends Base {
    param tint : color

    surface(geo) -> color {
        return super.surface(geo) * tint
    }
}

// Inputs are linear-light colors and normalized directions. BRDF results do
// not include incident radiance or the N.L integration factor.
fn mlPow5(x: float) -> float {
    let x2 = x * x
    return x2 * x2 * x
}
fn mlFresnelSchlick(cosTheta: float, f0: vec3) -> vec3 {
    return f0 + (vec3f(1.0, 1.0, 1.0) - f0) * mlPow5(1.0 - clamp(cosTheta, 0.0, 1.0))
}
fn mlGGXD(nh: float, roughness: float) -> float {
    let alpha = max(clamp(roughness, 0.0, 1.0) * clamp(roughness, 0.0, 1.0), 0.0025)
    let a2 = alpha * alpha
    let c = clamp(nh, 0.0, 1.0)
    let den = (1.0 - c * c) + c * c * a2
    return a2 / (3.14159265359 * den * den)
}
fn mlGGXVisibility(nv: float, nl: float, roughness: float) -> float {
    let alpha = max(clamp(roughness, 0.0, 1.0) * clamp(roughness, 0.0, 1.0), 0.0025)
    let a2 = alpha * alpha
    let v = clamp(nv, 0.0, 1.0)
    let l = clamp(nl, 0.0, 1.0)
    let gv = l * sqrt(v * v * (1.0 - a2) + a2)
    let gl = v * sqrt(l * l * (1.0 - a2) + a2)
    return 0.5 / max(gv + gl, 0.000001)
}
fn mlGGXEnergyCompensation(f0: vec3, singleScatterEnergy: float) -> vec3 {
    let energy = clamp(singleScatterEnergy, 0.05, 1.0)
    return vec3f(1.0, 1.0, 1.0) + f0 * (1.0 / energy - 1.0)
}
fn mlGGX(nv: float, nl: float, nh: float, vh: float, roughness: float, f0: vec3, singleScatterEnergy: float) -> vec3 {
    let response = mlFresnelSchlick(vh, f0) * mlGGXD(nh, roughness) * mlGGXVisibility(nv, nl, roughness)
    return response * mlGGXEnergyCompensation(f0, singleScatterEnergy) * (nv > 0.0 && nl > 0.0 ? 1.0 : 0.0)
}
fn mlClearCoat(base: vec3, nv: float, nl: float, nh: float, vh: float, roughness: float, weight: float) -> vec3 {
    let w = clamp(weight, 0.0, 1.0)
    let fv = 0.04 + 0.96 * mlPow5(1.0 - clamp(nv, 0.0, 1.0))
    let fl = 0.04 + 0.96 * mlPow5(1.0 - clamp(nl, 0.0, 1.0))
    let coat = mlGGX(nv, nl, nh, vh, roughness, vec3f(0.04, 0.04, 0.04), 1.0)
    return base * (1.0 - w * fv) * (1.0 - w * fl) + coat * w
}
fn mlCharlieD(nh: float, roughness: float) -> float {
    let inverseR = 1.0 / max(clamp(roughness, 0.0, 1.0), 0.07)
    let c = clamp(nh, 0.0, 1.0)
    return (2.0 + inverseR) * pow(max(1.0 - c * c, 0.0), inverseR * 0.5) / 6.28318530718
}
fn mlSheenCharlie(nv: float, nl: float, nh: float, roughness: float, tint: vec3) -> vec3 {
    let v = clamp(nv, 0.0, 1.0)
    let l = clamp(nl, 0.0, 1.0)
    let visibility = 1.0 / max(4.0 * (v + l - v * l), 0.000001)
    return tint * mlCharlieD(nh, roughness) * visibility * (nv > 0.0 && nl > 0.0 ? 1.0 : 0.0)
}
fn mlAnisotropicGGXD(h: vec3, alphaT: float, alphaB: float) -> float {
    let at = max(abs(alphaT), 0.0025)
    let ab = max(abs(alphaB), 0.0025)
    let q = vec3f(h.x / at, h.y / ab, h.z)
    let den = dot(q, q)
    return 1.0 / max(3.14159265359 * at * ab * den * den, 0.00000001)
}
fn mlAnisotropicGGX(v: vec3, l: vec3, h: vec3, alphaT: float, alphaB: float, f0: vec3, singleScatterEnergy: float) -> vec3 {
    let at = max(abs(alphaT), 0.0025)
    let ab = max(abs(alphaB), 0.0025)
    let gv = l.z * length(vec3f(at * v.x, ab * v.y, v.z))
    let gl = v.z * length(vec3f(at * l.x, ab * l.y, l.z))
    let vis = 0.5 / max(gv + gl, 0.000001)
    return mlFresnelSchlick(max(dot(v, h), 0.0), f0) * mlAnisotropicGGXD(h, at, ab) * vis * mlGGXEnergyCompensation(f0, singleScatterEnergy) * (v.z > 0.0 && l.z > 0.0 ? 1.0 : 0.0)
}
fn mlWrapDiffuse(nl: float, wrap: float) -> float {
    let w = clamp(wrap, 0.0, 1.0)
    return max(nl + w, 0.0) / ((1.0 + w) * (1.0 + w) * 3.14159265359)
}
fn mlThinTransmission(nl: float, thickness: float, strength: float) -> float {
    return max(-nl, 0.0) * (1.0 - clamp(thickness, 0.0, 1.0)) * clamp(strength, 0.0, 1.0) / 3.14159265359
}
